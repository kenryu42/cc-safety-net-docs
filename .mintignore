# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Standalone project wiki (not part of the Mintlify docs site; uses
# relative .md cross-links that are not docs routes)
cc-safety-net-wiki/

# Internal working notes (audit reports, plans); not docs routes, and
# plain-text angle brackets in them must not parse as MDX
docs/
