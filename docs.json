{
  "$schema": "https://mintlify.com/docs.json",
  "name": "CC Safety Net",
  "description": "CC Safety Net documentation. CC Safety Net is a pre-execution hook for AI coding agents that uses semantic analysis to block destructive Git and filesystem commands and secret-file access before they run.",
