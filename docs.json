{
  "$schema": "https://mintlify.com/docs.json",
  "name": "CC Safety Net",
  "description": "Documentation for CC Safety Net, a PreToolUse hook that intercepts and blocks destructive git and filesystem commands before AI coding agents run them using semantic analysis that pattern matching and sandboxing cannot match.",
  "theme": "luma",
  "colors": {
    "primary": "#005f46",
    "light": "#5ee8b5",
    "dark": "#0f7a4d"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#f5f8f7",
      "dark": "#091c1e"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": false,
    "codeblocks": "dark"
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "metatags": {
      "theme-color": "#005f46",
      "color-scheme": "light dark"
    }
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "href": "/",
    "light": "/assets/cc-safety-net-header-logo-light.svg",
    "dark": "/assets/cc-safety-net-header-logo-dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/kenryu42/cc-safety-net"
    }
  },
  "banner": {
    "content": "For AI agents: read the complete documentation index at [`/llms.txt`](/llms.txt).",
    "dismissible": true,
    "type": "info"
  },
  "search": {
    "prompt": "Search commands, agents, and rules..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ],
    "display": "toc"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "introduction",
          "installation",
          "quickstart",
          "guides/how-it-works",
          "guides/dashboard"
        ]
      },
      {
        "group": "Configuration",
        "pages": [
          "configuration/modes",
          "configuration/policy",
          "configuration/environment",
          "configuration/custom-rules",
          "configuration/status-line",
          "configuration/recovery"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/blocked-commands",
          "reference/allowed-commands",
          "reference/audit-log",
          "reference/cli-commands",
          "reference/explain-trace",
          "reference/glossary"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          {
            "group": "Concepts",
            "pages": [
              "guides/architecture",
              "guides/analysis-engine",
              "guides/design-principles",
              "guides/security-model"
            ]
          },
          {
            "group": "Comparisons and integration",
            "pages": [
              "guides/vs-sandboxing",
              "guides/integration-architecture"
            ]
          },
          {
            "group": "Limits and troubleshooting",
            "pages": [
              "guides/known-limitations",
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "group": "Project",
        "pages": [
          "contributing",
          "security"
        ]
      }
    ]
  }
}