{
  "$schema": "https://mintlify.com/docs.json",
  "name": "CC Safety Net",
  "description": "CC Safety Net documentation. The PreToolUse hook uses semantic analysis to block destructive Git and filesystem commands and secret-file access before AI coding agents run them.",
  "theme": "luma",
  "colors": {
    "primary": "#005f46",
    "light": "#5ee8b5",
    "dark": "#0f7a4d"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#f5f8f7",
      "dark": "#091c1e"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": false,
    "codeblocks": "dark"
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "metatags": {
      "theme-color": "#005f46",
      "color-scheme": "light dark"
    }
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "light": "/assets/cc-safety-net-header-logo-light.svg",
    "dark": "/assets/cc-safety-net-header-logo-dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/kenryu42/cc-safety-net"
    }
  },
  "banner": {
    "content": "AI agents can read the complete documentation index at [`/llms.txt`](/llms.txt).",
    "dismissible": true,
    "type": "info"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ],
    "display": "toc"
  },
